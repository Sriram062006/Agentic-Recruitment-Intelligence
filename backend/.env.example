# Application Environment
APP_ENV=development
APP_NAME="Agentic AI Recruitment Intelligence Platform"
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# External Service Credentials (Placeholder values only - do NOT commit secrets)
GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Vector Storage Configuration
FAISS_INDEX_PATH=data/faiss/candidates.index

# Configurable Initial Baseline Fitment Weights (Subject to experimental validation)
SEMANTIC_WEIGHT=0.35
SKILL_WEIGHT=0.35
EXPERIENCE_WEIGHT=0.20
QUALIFICATION_WEIGHT=0.10

# Experimental Heuristic Parameters (Subject to research benchmarking)
ALPHA_SKILL_WEIGHT=0.80
BETA_EXPERIENCE_PENALTY=1.50
FITMENT_STRONG_THRESHOLD=0.75
FITMENT_MODERATE_THRESHOLD=0.50
